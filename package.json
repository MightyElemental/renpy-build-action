{
  "name": "build-renpy-project",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "build:bundle": "esbuild lib/main.js --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.cjs",
    "build": "npm run build:ts && npm run build:bundle",
    "package": "npm run build",
    "lint": "node -c dist/index.cjs || true"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "esbuild": "^0.27.4",
    "typescript": "^6.0.2"
  },
  "description": "Build a Ren'Py project",
  "keywords": [],
  "author": "MightyElemental",
  "license": "MIT"
}
